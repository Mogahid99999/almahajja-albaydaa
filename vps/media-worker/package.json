{
  "name": "almahajja-media-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side media worker: claims media_jobs from Supabase, transcodes with ffmpeg, stores MP3s on R2, receives LiveKit webhooks.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-shared": "node scripts/sync-shared.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "transcode-local": "node dist/cli/transcode-local.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@supabase/supabase-js": "^2.117.2",
    "livekit-server-sdk": "^2.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
