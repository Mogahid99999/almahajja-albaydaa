# Supabase — copy this file to `.env` and fill in your project values.
# Find these in the Supabase dashboard › Project Settings › API.
# Only the PUBLIC anon key belongs here (RLS-gated). Never put the
# service_role key in the client.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run scripts/seed-*.mjs (demo account setup). Pick your own
# strong password — never commit a real value here.
SEED_PASSWORD=

# Madinah mushaf pack (static files on our own server — scripts/mushaf/README.md).
# Optional: unset = only the simplified mushaf is offered. HTTPS in release builds.
EXPO_PUBLIC_MUSHAF_PACK_URL=
